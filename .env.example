# ==========================================================
# Template de variaveis de ambiente
# ==========================================================
# Copie este arquivo para .env e ajuste se necessario.
# O arquivo .env NAO vai para o Git (ver .gitignore).
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / Mac / Git Bash: cp .env.example .env
#
# Nenhuma chave de API e necessaria para rodar o assistente:
# o modelo roda localmente no Ollama e os embeddings tambem.
# ==========================================================

# Endereco do Ollama local.
OLLAMA_BASE_URL=http://localhost:11434

# Nome do modelo ajustado registrado no Ollama
# (criado com: ollama create assistente-medico -f modelo/Modelfile).
MODELO_AJUSTADO=assistente-medico

# Temperatura baixa: resposta clinica precisa ser estavel, nao criativa.
TEMPERATURA=0.1

# Modelo de embeddings para a busca nos protocolos (roda local, multilingue).
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Semente global (geracao de dados, divisao treino/validacao/teste).
RANDOM_SEED=42

# Onde gravar o log de auditoria (JSON Lines, um evento por linha).
ARQUIVO_AUDITORIA=logs/auditoria.jsonl
