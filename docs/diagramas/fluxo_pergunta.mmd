	verificar_resposta -. &nbsp;tentar_de_novo&nbsp; .-> responder;
	anotar_ressalva --> __end__;
	recusar --> __end__;
	sem_base --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
